# Application Settings
APP_NAME=IoT SaaS Platform
APP_VERSION=0.1.0
ENVIRONMENT=dev
DEBUG=false
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://iot:iot@localhost:5432/iot

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

# Security
SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
